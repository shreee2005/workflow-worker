{
  "name": "Conditional Processing",
  "description": "Process data through validation then parallel transformation",
  "steps": [
    {
      "type": "HTTP_CALL",
      "name": "validate_data",
      "config": {
        "url": "https://api.example.com/validate",
        "method": "POST",
        "body": "{\"data\": \"input\"}"
      }
    },
    {
      "type": "HTTP_CALL",
      "name": "transform_a",
      "dependsOn": [0],
      "config": {
        "url": "https://api.example.com/transform",
        "method": "POST",
        "body": "${steps[0].output}"
      }
    },
    {
      "type": "HTTP_CALL",
      "name": "transform_b",
      "dependsOn": [0],
      "config": {
        "url": "https://api.example.com/transform",
        "method": "POST",
        "body": "${steps[0].output}"
      }
    },
    {
      "type": "HTTP_CALL",
      "name": "aggregate",
      "dependsOn": [1, 2],
      "config": {
        "url": "https://api.example.com/aggregate",
        "method": "POST"
      }
    }
  ]
}
